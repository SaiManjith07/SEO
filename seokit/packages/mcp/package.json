{
  "name": "@seokit/mcp",
  "version": "3.0.0",
  "description": "SEOKit v3 Model Context Protocol (MCP) server.",
  "type": "module",
  "bin": { "seokit-mcp": "./dist/index.js" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@seokit/core": "workspace:*",
    "@seokit/orchestrator": "workspace:*",
    "@seokit/workspace": "workspace:*",
    "@seokit/events": "workspace:*",
    "@seokit/diagnostics": "workspace:*",
    "@seokit/plugin-seo": "workspace:*",
    "@seokit/plugin-performance": "workspace:*",
    "@seokit/plugin-accessibility": "workspace:*",
    "@seokit/plugin-aeo": "workspace:*",
    "@seokit/plugin-geo": "workspace:*",
    "@seokit/plugin-security": "workspace:*",
    "@seokit/plugin-structured-data": "workspace:*",
    "express": "^4.19.2",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0",
    "@types/express": "^4.17.21",
    "vitest": "^2.1.0"
  },
  "license": "MIT"
}
