{
  "name": "@seokit/orchestrator",
  "version": "1.0.0",
  "description": "Multi-agent coordination orchestrator for SEO/AEO/GEO/LLMO automation.",
  "type": "module",
  "bin": {
    "seokit-orchestrate": "./dist/cli.js"
  },
  "main": "./dist/loop.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
