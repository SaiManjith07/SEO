    "@seokit/providers": "workspace:*",
    "@seokit/workspace": "workspace:*",
    "@seokit/events": "workspace:*",
    "@seokit/plugin-seo": "workspace:*",
    "@seokit/plugin-performance": "workspace:*",
    "@seokit/plugin-accessibility": "workspace:*",
    "@seokit/plugin-aeo": "workspace:*",
    "@seokit/plugin-geo": "workspace:*",
    "@seokit/plugin-framework": "workspace:*",
    "@seokit/framework-detector": "workspace:*",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
