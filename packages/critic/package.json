{
  "name": "@seokit/critic",
  "version": "1.0.0",
  "description": "Independent SEO/GEO verification against published benchmarks. Emits a reward signal.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
  },
  "files": ["dist"],
