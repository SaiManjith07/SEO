{
  "name": "@seokit/cli",
  "version": "3.0.0",
  "description": "SEOKit v3 Platform CLI Client.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "seokit-v3": "./dist/index.js",
    "seokit-v2": "./dist/index.js",
    "seokit": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@seokit/critic-aeolint": "workspace:*",
    "@seokit/diagnostics": "workspace:*",
    "@seokit/events": "workspace:^1.0.0",
    "@seokit/mcp": "workspace:*",
    "@seokit/orchestrator": "workspace:^1.0.0",
    "@seokit/plugin-accessibility": "workspace:*",
    "@seokit/plugin-aeo": "workspace:*",
    "@seokit/plugin-crux": "workspace:*",
    "@seokit/plugin-geo": "workspace:*",
    "@seokit/plugin-gsc": "workspace:*",
    "@seokit/plugin-performance": "workspace:*",
    "@seokit/plugin-security": "workspace:*",
    "@seokit/plugin-seo": "workspace:*",
    "@seokit/plugin-structured-data": "workspace:*",
    "@seokit/plugins-competitive": "workspace:^",
    "@seokit/workspace": "workspace:^1.0.0"
  }
}
